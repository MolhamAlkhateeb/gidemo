{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AWS": {
    "Region": "us-east-1"
  },
  "Bedrock": {
    "Region": "us-west-2",
    "RouterModelId": "amazon.nova-micro-v1:0"
  },
  "Storage": {
    "S3Bucket": "REPLACE_WITH_YOUR_BUCKET"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=chatbot;Username=postgres;Password=postgres"
  },
  "Cognito": {
    "Authority": "https://cognito-idp.us-east-1.amazonaws.com/REPLACE_USER_POOL_ID",
    "Audience": "REPLACE_APP_CLIENT_ID",
    "Region": "us-east-1"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
