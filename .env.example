# Copy to .env and fill in. NEVER commit real secrets.
AWS_REGION=us-east-1
# Bedrock region (image-generation models are on-demand in us-west-2).
BEDROCK_REGION=us-west-2

# A dedicated dev IAM user's credentials (see README section 4).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for uploads/outputs (create it or let CloudFormation create it).
S3_BUCKET=
